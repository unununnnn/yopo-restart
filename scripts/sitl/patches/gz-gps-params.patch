--- a/src/modules/simulation/gz_bridge/parameters.c
+++ b/src/modules/simulation/gz_bridge/parameters.c
@@ -105,3 +105,72 @@
  * @value 1 Enabled
  */
 PARAM_DEFINE_INT32(SIM_GZ_EN_GPS, 1);
+
+/**
+ * Simulated GPS fix type published by the Gazebo bridge
+ *
+ * 3 = 3D fix (default, metre-level). 6 = RTK fixed.
+ * Other values follow SensorGps.msg (0/1 none, 2 2D, 4 RTCM, 5 RTK float).
+ *
+ * @min 0
+ * @max 8
+ * @group Simulation
+ * @value 0 No fix
+ * @value 3 3D fix
+ * @value 5 RTK float
+ * @value 6 RTK fixed
+ */
+PARAM_DEFINE_INT32(SIM_GZ_GPS_FIX, 3);
+
+/**
+ * Simulated GPS horizontal accuracy (eph) published by the Gazebo bridge
+ *
+ * EKF2 uses max(eph, EKF2_GPS_P_NOISE) as horizontal position measurement noise.
+ *
+ * @min 0.01
+ * @max 100
+ * @decimal 2
+ * @unit m
+ * @group Simulation
+ */
+PARAM_DEFINE_FLOAT(SIM_GZ_GPS_EPH, 0.9f);
+
+/**
+ * Simulated GPS vertical accuracy (epv) published by the Gazebo bridge
+ *
+ * EKF2 uses max(epv, 1.5 * EKF2_GPS_P_NOISE) as vertical measurement noise.
+ *
+ * @min 0.01
+ * @max 100
+ * @decimal 2
+ * @unit m
+ * @group Simulation
+ */
+PARAM_DEFINE_FLOAT(SIM_GZ_GPS_EPV, 1.78f);
+
+/**
+ * Gazebo bridge GPS position noise amplitude (addGpsNoise)
+ *
+ * Default 0.8 m matches the ublox F9P standalone model hardcoded in PX4 v1.17.0.
+ * RTK-class: about 0.02 m.
+ *
+ * @min 0.0
+ * @max 10
+ * @decimal 3
+ * @unit m
+ * @group Simulation
+ */
+PARAM_DEFINE_FLOAT(SIM_GZ_GPS_NAMP, 0.8f);
+
+/**
+ * Gazebo bridge GPS velocity noise amplitude (addGpsNoise)
+ *
+ * Default 0.05 m/s matches PX4 v1.17.0. RTK-class: about 0.01 m/s.
+ *
+ * @min 0.0
+ * @max 5
+ * @decimal 3
+ * @unit m/s
+ * @group Simulation
+ */
+PARAM_DEFINE_FLOAT(SIM_GZ_GPS_VAMP, 0.05f);
