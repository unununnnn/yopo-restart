# 仅由 scripts/sitl/in_container.sh 在 YOPO_SITL_PLANNER=yopo-l0 时 source。
# PX4 v1.17 这两个参数的分组是 SITL（battery_simulator），真机固件里没有这组默认值。
# 不写 COM_LOW_BAT_ACT、COM_FLTT_LOW_ACT、BAT_CRIT_THR、NAV_RCL_ACT、COM_OF_LOSS_T。
#
# 模拟电池电量 = max(剩余, SIM_BAT_MIN_PCT/100)，放电时间常数是 SIM_BAT_DRAIN 秒放完一整个包。
# 默认 60 s 放完、下限 50%。这里放到参数允许的最慢放电（上限 86400 s），下限抬到 100%，
# 让仿真电压停在满电，不进 WARNING_CRITICAL。返航本身不是这条参数触发的，见实飞脚本里的设定点心跳。
export PX4_PARAM_SIM_BAT_DRAIN=86400
export PX4_PARAM_SIM_BAT_MIN_PCT=100
