# 仅由 scripts/sitl/in_container.sh 在 YOPO_POSITIONING=rtk 时 source。
# 只允许定位/估计参数（S1b 白名单）。PX4 rcS 会把 PX4_PARAM_* 转成启动时的 param set。
export PX4_PARAM_SIM_GZ_GPS_FIX=6
export PX4_PARAM_SIM_GZ_GPS_EPH=0.02
export PX4_PARAM_SIM_GZ_GPS_EPV=0.03
export PX4_PARAM_SIM_GZ_GPS_NAMP=0.02
export PX4_PARAM_SIM_GZ_GPS_VAMP=0.01
export PX4_PARAM_EKF2_GPS_P_NOISE=0.03
export PX4_PARAM_EKF2_GPS_V_NOISE=0.03
export PX4_PARAM_EKF2_HGT_REF=1
